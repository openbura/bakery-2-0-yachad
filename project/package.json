{
  "name": "bakery-2-0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "qa:review": "node ../review/qa-online.cjs",
    "qa:sql": "node ../review/local-db/verify-orders.cjs",
    "qa:push": "node ../review/push-tools/verify-push.cjs && node ../review/push-tools/verify-worker.cjs",
    "qa:push:browser": "node ../review/push-tools/qa-push.cjs",
    "test:domain": "node --experimental-strip-types --test domain-tests/operational.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.110.2",
    "@vitejs/plugin-react": "^6.0.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
